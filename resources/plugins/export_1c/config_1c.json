{
  "ui": {
    "fields":
    [
      {
	"id": "platform",
	"type": "string",
	"label": "1cv8.exe",
	"placeholder": "C:\\Program Files (x86)\\1cv8\\8.3.11.2867\\bin\\1cv8.exe",
	"required": true
      },
      {
	"id": "typeDB",
	"type": "enum",
	"label": "Type database",
	"values": ["File", "MSSQL"],
	"required": true,
	"default": "File"
      },
      {
	"id": "database",
	"type": "string",
	"label": "Name database",
	"placeholder": "base_sql",
	"visible_if": { "applyAllDB": false }
      },
      {
	"id": "dbPath",
	"type": "string",
	"label": "Path to DB",
	"placeholder": "C:\\Database\\Base",
	"visible_if": {
	  "typeDB": "File",
	  "applyAllDB": false
	}
      },
      {
	"id": "server",
	"type": "string",
	"label": "Server",
	"placeholder": "localhost\\SQLEXPRESS",
	"visible_if": {
	  "typeDB": "MSSQL",
	  "applyAllDB": false
	}
      },
      {
	"id": "user",
	"type": "string",
	"label": "User",
	"placeholder": "admin",
	"required": true
      },
      {
	"id": "password",
	"type": "password",
	"label": "Password",
	"placeholder": "123456"
      },
      {
	"id": "applyAllDB",
	"type": "checkbox",
	"label": "Apply to all databases",
	"default": false
      }
    ]
  }
}
